(version 1)
; graft's Seatbelt profile, its fixed part (lib/sandbox/seatbelt.nix). seatbelt.nix appends the
; closure (sb_store in seatbelt.sh), the launcher appends the run (sb_profile): the repository, the
; host paths, the terminal, the proxy's port, and last the denies that nothing may reopen.
;
; Deny by default. What a process needs from macOS is allowed here, read-only: the dyld and system
; libraries, frameworks, zoneinfo and locales, /private/etc, /dev's standard devices, a few sysctls
; and Mach services. Nothing of the user's: no home, no /Users, no /tmp, no /Volumes, no other store
; path. Sources: Nix's own darwin build sandbox (src/libstore/darwin/build/sandbox-defaults.sb),
; OpenAI codex's seatbelt_base_policy.sbpl and its platform defaults, and Anthropic's sandbox-runtime
; (macos-sandbox-utils.ts), all after Chromium's mac/common.sb.
(deny default)

; Processes: its own. No process-info and no signal toward a process outside the sandbox (the
; launcher's environment, through KERN_PROCARGS2, is process-info).
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))

; sysctls that libc, Python, Node and Go read (codex's and sandbox-runtime's lists, without
; kern.proc.all: no listing every process)
(allow sysctl-read
  (sysctl-name "hw.activecpu")
  (sysctl-name "hw.busfrequency_compat")
  (sysctl-name "hw.byteorder")
  (sysctl-name "hw.cacheconfig")
  (sysctl-name "hw.cachelinesize_compat")
  (sysctl-name "hw.cpufamily")
  (sysctl-name "hw.cpufrequency")
  (sysctl-name "hw.cpufrequency_compat")
  (sysctl-name "hw.cputype")
  (sysctl-name "hw.l1dcachesize_compat")
  (sysctl-name "hw.l1icachesize_compat")
  (sysctl-name "hw.l2cachesize_compat")
  (sysctl-name "hw.l3cachesize_compat")
  (sysctl-name "hw.logicalcpu")
  (sysctl-name "hw.logicalcpu_max")
  (sysctl-name "hw.machine")
  (sysctl-name "hw.memsize")
  (sysctl-name "hw.model")
  (sysctl-name "hw.ncpu")
  (sysctl-name "hw.nperflevels")
  (sysctl-name "hw.packages")
  (sysctl-name "hw.pagesize")
  (sysctl-name "hw.pagesize_compat")
  (sysctl-name "hw.physicalcpu")
  (sysctl-name "hw.physicalcpu_max")
  (sysctl-name "hw.tbfrequency_compat")
  (sysctl-name "hw.vectorunit")
  (sysctl-name "kern.argmax")
  (sysctl-name "kern.hostname")
  (sysctl-name "kern.maxfiles")
  (sysctl-name "kern.maxfilesperproc")
  (sysctl-name "kern.maxproc")
  (sysctl-name "kern.ngroups")
  (sysctl-name "kern.osproductversion")
  (sysctl-name "kern.osrelease")
  (sysctl-name "kern.ostype")
  (sysctl-name "kern.osvariant_status")
  (sysctl-name "kern.osversion")
  (sysctl-name "kern.secure_kernel")
  (sysctl-name "kern.sysv.semmns")
  (sysctl-name "kern.usrstack64")
  (sysctl-name "kern.version")
  (sysctl-name "machdep.cpu.brand_string")
  (sysctl-name "machdep.ptrauth_enabled")
  (sysctl-name "sysctl.proc_cputype")
  (sysctl-name "vm.loadavg")
  (sysctl-name-prefix "hw.optional.")
  (sysctl-name-prefix "hw.perflevel")
  (sysctl-name-prefix "kern.proc.pgrp.")
  (sysctl-name-prefix "kern.proc.pid.")
  (sysctl-name-prefix "machdep.cpu.")
  (sysctl-name-prefix "net.routetable."))

; Mach services: getpwuid and group membership (opendirectoryd), confstr's user directories
; (dirhelper), logging, notify(3). No keychain (SecurityServer), no trustd, no DNS (mDNSResponder),
; no launch services, no pasteboard.
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.logd")
  (global-name "com.apple.system.notification_center"))

; Python's multiprocessing locks
(allow ipc-posix-sem)

; AF_UNIX sockets: socketpair(2) (libuv's child pipes, so Node's). Binding or connecting to a
; socket path is network-bind and network-outbound, which the launcher allows below the run's
; writable paths alone.
(allow system-socket (socket-domain AF_UNIX))

; macOS, read-only
(allow file-read*
  (literal "/")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/System/Library")
  (subpath "/System/Cryptexes")
  (subpath "/System/Volumes/Preboot/Cryptexes")
  (subpath "/Library/Apple")
  (subpath "/private/etc")
  (subpath "/private/var/db/timezone")
  (subpath "/private/var/db/dyld")
  (literal "/private/var/select/sh"))
; /bin/sh (which runs bash, dash or zsh, as /private/var/select/sh says) and /usr/bin/env, for
; scripts' first lines
(allow file-read* process-exec
  (literal "/bin/sh")
  (literal "/bin/bash")
  (literal "/bin/dash")
  (literal "/bin/zsh")
  (literal "/usr/bin/env"))
; what realpath(3) and getcwd(3) stat on the way (names and attributes only, no listing)
(allow file-read-metadata
  (literal "/bin")
  (literal "/dev")
  (literal "/etc")
  (literal "/Library")
  (literal "/nix")
  (literal "/nix/store")
  (literal "/private")
  (literal "/private/var")
  (literal "/private/var/db")
  (literal "/private/var/select")
  (literal "/System")
  (literal "/System/Volumes")
  (literal "/System/Volumes/Preboot")
  (literal "/tmp")
  (literal "/usr")
  (literal "/usr/bin")
  (literal "/var"))

; Devices
(allow file-read* file-write-data file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/dtracehelper"))
(allow file-read*
  (literal "/dev/random")
  (literal "/dev/urandom"))
(allow file-read* file-write-data
  (literal "/dev/stdin")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (subpath "/dev/fd"))
; the controlling terminal (the launcher allows the caller's terminal device by its name too). Not
; every /dev/ttys*: another terminal of the same user could be read.
(allow file-read* file-write-data file-ioctl
  (literal "/dev/tty"))
; pseudo-terminals the run opens itself (script, tmux, a Node pty): new ones only
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl
  (literal "/dev/ptmx"))
(allow file-read* file-write* file-ioctl
  (require-all
    (regex #"^/dev/ttys[0-9]+$")
    (extension "com.apple.sandbox.pty")))
